{% style %}
  .password-main-{{ section.id }}{display:grid;min-height:100vh;place-items:center;padding:1.5rem;background:linear-gradient(135deg,{{ section.settings.background }},{{ section.settings.background_alt }});color:{{ section.settings.text_color }}}
  .password-main-{{ section.id }} .password-main__card{width:min(100%,560px);padding:clamp(1.5rem,5vw,3.5rem);border:1px solid rgba(255,255,255,.13);border-radius:24px;background:rgba(255,255,255,.06);box-shadow:0 30px 90px rgba(0,0,0,.3);text-align:center;backdrop-filter:blur(16px)}
  .password-main-{{ section.id }} h1{margin:0;color:inherit;font-size:clamp(2rem,6vw,3.5rem);letter-spacing:-.045em}.password-main-{{ section.id }} p{margin:1rem 0;color:color-mix(in srgb,{{ section.settings.text_color }} 70%,transparent);line-height:1.6}
  .password-main-{{ section.id }} form{display:grid;gap:.7rem;margin-top:1.5rem}.password-main-{{ section.id }} input{width:100%;min-height:48px;padding:.8rem 1rem;border:1px solid rgba(255,255,255,.2);border-radius:11px;background:rgba(0,0,0,.18);color:inherit;font:inherit}.password-main-{{ section.id }} button{min-height:48px;border:0;border-radius:11px;background:{{ section.settings.accent }};color:#fff;font:inherit;font-weight:800;cursor:pointer}
{% endstyle %}

<main class="password-main-{{ section.id }}">
  <div class="password-main__card">
    <h1>{{ shop.name | escape }}</h1>
    {% unless shop.password_message == blank %}<p>{{ shop.password_message }}</p>{% endunless %}
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <label class="visually-hidden" for="Password-{{ section.id }}">Senha da loja</label>
      <input id="Password-{{ section.id }}" type="password" name="password" autocomplete="current-password" placeholder="Digite a senha">
      <button type="submit">Entrar na loja</button>
    {% endform %}
  </div>
</main>

{% schema %}
{"name":"Página com senha","settings":[{"type":"color","id":"background","label":"Fundo inicial","default":"#050b16"},{"type":"color","id":"background_alt","label":"Fundo final","default":"#102b58"},{"type":"color","id":"text_color","label":"Texto","default":"#ffffff"},{"type":"color","id":"accent","label":"Destaque","default":"#135ee8"}]}
{% endschema %}
