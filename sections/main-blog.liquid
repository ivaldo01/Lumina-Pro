{% style %}
  .blog-main-{{ section.id }}{padding:clamp(2rem,6vw,6rem) clamp(1rem,3vw,2.5rem);background:{{ section.settings.background }}}
  .blog-main-{{ section.id }} .blog-main__inner{width:min(100%,{{ section.settings.max_width }}px);margin:auto}
  .blog-main-{{ section.id }} .blog-main__header{max-width:760px;margin-bottom:3rem}.blog-main-{{ section.id }} .blog-main__header span{color:{{ section.settings.accent }};font-size:.7rem;font-weight:850;letter-spacing:.16em;text-transform:uppercase}.blog-main-{{ section.id }} h1{margin:.4rem 0 0;font-size:clamp(2rem,5vw,3.8rem);letter-spacing:-.045em}
  .blog-main-{{ section.id }} .blog-main__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.4rem}
  .blog-main-{{ section.id }} .article-card{overflow:hidden;border:1px solid #e3e8ef;border-radius:20px;background:#fff;box-shadow:0 12px 35px rgba(15,23,42,.05);transition:.35s}.blog-main-{{ section.id }} .article-card:hover{transform:translateY(-7px);box-shadow:0 22px 50px rgba(15,23,42,.11)}
  .blog-main-{{ section.id }} .article-card__media{display:block;aspect-ratio:16/10;overflow:hidden;background:#edf1f6}.blog-main-{{ section.id }} .article-card__media img{width:100%;height:100%;object-fit:cover;transition:transform .6s}.blog-main-{{ section.id }} .article-card:hover img{transform:scale(1.05)}
  .blog-main-{{ section.id }} .article-card__body{padding:1.25rem}.blog-main-{{ section.id }} .article-card__meta{color:#778196;font-size:.67rem}.blog-main-{{ section.id }} .article-card h2{margin:.6rem 0;font-size:1.15rem;line-height:1.3}.blog-main-{{ section.id }} .article-card p{color:#667085;font-size:.78rem;line-height:1.6}
  .blog-main-{{ section.id }} .blog-main__pagination{display:flex;justify-content:center;gap:.5rem;margin-top:2.5rem}.blog-main-{{ section.id }} .blog-main__pagination a,.blog-main-{{ section.id }} .blog-main__pagination span{padding:.65rem .85rem;border:1px solid #dfe4eb;border-radius:9px}
  @media(max-width:900px){.blog-main-{{ section.id }} .blog-main__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.blog-main-{{ section.id }} .blog-main__grid{grid-template-columns:1fr}}
{% endstyle %}

<section class="blog-main-{{ section.id }}">
  <div class="blog-main__inner">
    <header class="blog-main__header" data-reveal><span>{{ section.settings.eyebrow | escape }}</span><h1>{{ blog.title | escape }}</h1></header>
    {% paginate blog.articles by section.settings.posts_per_page %}
      <div class="blog-main__grid">
        {% for article in blog.articles %}
          <article class="article-card" data-reveal>
            <a class="article-card__media" href="{{ article.url }}">{% if article.image %}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900' }}{% endif %}</a>
            <div class="article-card__body"><p class="article-card__meta">{{ article.published_at | date: format: 'date' }} · {{ article.author | escape }}</p><a href="{{ article.url }}"><h2>{{ article.title | escape }}</h2></a><p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p></div>
          </article>
        {% else %}
          <div class="article-card__body">
            <h2>Nenhum artigo publicado</h2>
            <p>Publique o primeiro artigo deste blog no painel da Shopify para que ele apareça aqui.</p>
          </div>
        {% endfor %}
      </div>
      {% if paginate.pages > 1 %}<nav class="blog-main__pagination" aria-label="Paginação do blog">{{ paginate | default_pagination }}</nav>{% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{"name":"Blog principal","settings":[{"type":"text","id":"eyebrow","label":"Chamada","default":"Conteúdo e inspiração"},{"type":"range","id":"posts_per_page","min":3,"max":18,"step":3,"label":"Artigos por página","default":9},{"type":"range","id":"max_width","min":900,"max":1700,"step":100,"unit":"px","label":"Largura máxima","default":1400},{"type":"color","id":"background","label":"Fundo","default":"#f5f7fa"},{"type":"color","id":"accent","label":"Destaque","default":"#135ee8"}]}
{% endschema %}
