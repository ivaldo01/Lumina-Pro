{% style %}
  .footer-pro-{{ section.id }}{--footer-bg:{{ section.settings.footer_bg }};--footer-text:{{ section.settings.footer_text }};--footer-link:{{ section.settings.footer_link }};--footer-hover:{{ section.settings.footer_link_hover }};--footer-accent:{{ section.settings.accent }};position:relative;padding:0 clamp(1rem,3vw,2.5rem) {{ section.settings.padding_bottom }}px;overflow:hidden;background:var(--footer-bg);color:var(--footer-text)}
  .footer-pro-{{ section.id }}::before{content:"";position:absolute;top:-300px;right:-240px;width:620px;height:620px;border-radius:50%;background:var(--footer-accent);filter:blur(150px);opacity:.13;pointer-events:none}
  .footer-pro-{{ section.id }} a{color:var(--footer-link);transition:color .25s ease,transform .25s ease}.footer-pro-{{ section.id }} a:hover{color:var(--footer-hover)}
  .footer-pro-{{ section.id }} .footer-pro__inner{position:relative;width:min(100%,{{ section.settings.max_width }}px);margin:auto}
  .footer-pro-{{ section.id }} .footer-pro__trust{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-right:1px solid rgba(255,255,255,.1);border-bottom:1px solid rgba(255,255,255,.1);border-left:1px solid rgba(255,255,255,.1)}
  .footer-pro-{{ section.id }} .footer-pro__trust-item{display:flex;align-items:center;justify-content:center;gap:.9rem;padding:1.15rem}
  .footer-pro-{{ section.id }} .footer-pro__trust-item+.footer-pro__trust-item{border-left:1px solid rgba(255,255,255,.1)}
  .footer-pro-{{ section.id }} .footer-pro__trust-icon{display:grid;flex:0 0 38px;width:38px;height:38px;place-items:center;border-radius:12px;background:{{ section.settings.accent | color_modify: 'alpha', 0.16 }};color:var(--footer-accent)}
  .footer-pro-{{ section.id }} .footer-pro__trust-icon svg{width:19px;height:19px}
  .footer-pro-{{ section.id }} .footer-pro__trust-item strong{display:block;font-size:.75rem}.footer-pro-{{ section.id }} .footer-pro__trust-item span{display:block;margin-top:.15rem;color:rgba(255,255,255,.55);font-size:.64rem}
  .footer-pro-{{ section.id }} .footer-pro__newsletter{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.8fr);gap:clamp(1.5rem,5vw,5rem);align-items:center;margin-top:clamp(2rem,5vw,4.5rem);padding:clamp(1.5rem,4vw,3.25rem);overflow:hidden;border:1px solid rgba(255,255,255,.11);border-radius:24px;background:linear-gradient(125deg,{{ section.settings.accent | color_modify: 'alpha', 0.2 }},rgba(255,255,255,.04));box-shadow:0 24px 70px rgba(0,0,0,.22)}
  .footer-pro-{{ section.id }} .footer-pro__eyebrow{margin:0 0 .55rem;color:var(--footer-accent);font-size:.67rem;font-weight:850;letter-spacing:.17em;text-transform:uppercase}
  .footer-pro-{{ section.id }} .footer-pro__newsletter-title{max-width:680px;margin:0;color:var(--footer-text);font-size:clamp(1.6rem,3vw,2.7rem);line-height:1.05;letter-spacing:-.04em}
  .footer-pro-{{ section.id }} .footer-pro__newsletter-text{max-width:600px;margin:.75rem 0 0;color:rgba(255,255,255,.62);font-size:.82rem;line-height:1.65}
  .footer-pro-{{ section.id }} .footer-pro__form{display:flex;gap:.55rem;padding:.4rem;border:1px solid rgba(255,255,255,.14);border-radius:999px;background:rgba(0,0,0,.2);backdrop-filter:blur(12px)}
  .footer-pro-{{ section.id }} .footer-pro__input{min-width:0;flex:1;padding:.75rem 1rem;border:0;background:transparent;color:#fff;font:inherit;font-size:.8rem;outline:0}.footer-pro-{{ section.id }} .footer-pro__input::placeholder{color:rgba(255,255,255,.45)}
  .footer-pro-{{ section.id }} .footer-pro__submit{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;min-height:44px;padding:.7rem 1.15rem;border:0;border-radius:999px;background:var(--footer-accent);color:#fff;font:inherit;font-size:.68rem;font-weight:850;letter-spacing:.05em;text-transform:uppercase;cursor:pointer;transition:transform .25s,filter .25s}.footer-pro-{{ section.id }} .footer-pro__submit:hover{transform:translateY(-2px);filter:brightness(1.1)}
  .footer-pro-{{ section.id }} .footer-pro__form-message{margin:.65rem .5rem 0;font-size:.72rem}.footer-pro-{{ section.id }} .footer-pro__form-message--success{color:#65e6ad}.footer-pro-{{ section.id }} .footer-pro__form-message--error{color:#ff8d8d}
  .footer-pro-{{ section.id }} .footer-pro__grid{display:grid;grid-template-columns:minmax(260px,1.25fr) repeat(auto-fit,minmax(155px,.65fr));gap:clamp(1.5rem,4vw,4rem);padding:clamp(3rem,6vw,6rem) 0}
  .footer-pro-{{ section.id }} .footer-pro__brand{max-width:380px}
  .footer-pro-{{ section.id }} .footer-pro__logo{display:block;width:auto;max-width:{{ section.settings.logo_width }}px;max-height:80px;object-fit:contain;margin-bottom:1.25rem}
  .footer-pro-{{ section.id }} .footer-pro__brand-name{margin:0 0 1rem;color:#fff;font-size:clamp(1.3rem,2vw,1.8rem);letter-spacing:-.03em}
  .footer-pro-{{ section.id }} .footer-pro__brand-text{color:rgba(255,255,255,.58);font-size:.78rem;line-height:1.75}.footer-pro-{{ section.id }} .footer-pro__brand-text p{margin:0}
  .footer-pro-{{ section.id }} .footer-pro__socials{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.25rem}
  .footer-pro-{{ section.id }} .footer-pro__social{display:inline-flex;align-items:center;justify-content:center;min-height:34px;padding:.45rem .65rem;border:1px solid rgba(255,255,255,.13);border-radius:999px;background:rgba(255,255,255,.035);font-size:.63rem;font-weight:750}.footer-pro-{{ section.id }} .footer-pro__social:hover{transform:translateY(-2px);border-color:var(--footer-accent)}
  .footer-pro-{{ section.id }} .footer-pro__column h3{margin:0 0 1.25rem;color:#fff;font-size:.69rem;font-weight:850;letter-spacing:.14em;text-transform:uppercase}
  .footer-pro-{{ section.id }} .footer-pro__column ul{display:grid;gap:.7rem;margin:0;padding:0;list-style:none}.footer-pro-{{ section.id }} .footer-pro__column li,.footer-pro-{{ section.id }} .footer-pro__column p{color:rgba(255,255,255,.57);font-size:.75rem;line-height:1.65}
  .footer-pro-{{ section.id }} .footer-pro__column a{display:inline-flex}.footer-pro-{{ section.id }} .footer-pro__column a:hover{transform:translateX(4px)}
  .footer-pro-{{ section.id }} .footer-pro__contact-list{display:grid;gap:.85rem}
  .footer-pro-{{ section.id }} .footer-pro__contact-item{display:flex;gap:.65rem;align-items:flex-start}.footer-pro-{{ section.id }} .footer-pro__contact-item svg{flex:0 0 17px;width:17px;margin-top:3px;color:var(--footer-accent)}
  .footer-pro-{{ section.id }} .footer-pro__bottom{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;padding-top:1.5rem;border-top:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.42);font-size:.65rem;letter-spacing:.03em}
  .footer-pro-{{ section.id }} .footer-pro__payments{display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:.4rem}.footer-pro-{{ section.id }} .footer-pro__payments svg{width:38px;height:24px}
  .footer-pro-{{ section.id }} .footer-pro__privacy-link{margin-top:.45rem;padding:0;border:0;background:transparent;color:rgba(255,255,255,.52);font:inherit;font-size:.64rem;text-decoration:underline;cursor:pointer}.footer-pro-{{ section.id }} .footer-pro__privacy-link:hover{color:#fff}
  .footer-pro-{{ section.id }} .footer-pro__back-top{display:grid;position:absolute;right:0;bottom:58px;width:42px;height:42px;place-items:center;border:1px solid rgba(255,255,255,.14);border-radius:50%;background:rgba(255,255,255,.06);color:#fff;cursor:pointer;transition:.25s}.footer-pro-{{ section.id }} .footer-pro__back-top:hover{transform:translateY(-4px);border-color:var(--footer-accent);background:var(--footer-accent)}
  @media(max-width:1100px){.footer-pro-{{ section.id }} .footer-pro__grid{grid-template-columns:repeat(2,minmax(0,1fr))}.footer-pro-{{ section.id }} .footer-pro__brand{max-width:none}}
  @media(max-width:749px){
    .footer-pro-{{ section.id }}{padding-right:12px;padding-left:12px}
    .footer-pro-{{ section.id }} .footer-pro__trust{grid-template-columns:1fr}.footer-pro-{{ section.id }} .footer-pro__trust-item{justify-content:flex-start;padding:.8rem 1rem}.footer-pro-{{ section.id }} .footer-pro__trust-item+.footer-pro__trust-item{border-top:1px solid rgba(255,255,255,.1);border-left:0}
    .footer-pro-{{ section.id }} .footer-pro__newsletter{grid-template-columns:1fr;padding:1.35rem;border-radius:18px}.footer-pro-{{ section.id }} .footer-pro__form{display:grid;border-radius:15px}.footer-pro-{{ section.id }} .footer-pro__submit{width:100%;border-radius:11px}
    .footer-pro-{{ section.id }} .footer-pro__grid{grid-template-columns:1fr;gap:2rem;padding:3rem 0}
    .footer-pro-{{ section.id }} .footer-pro__column{padding-top:1.5rem;border-top:1px solid rgba(255,255,255,.09)}
    .footer-pro-{{ section.id }} .footer-pro__bottom{align-items:flex-start;flex-direction:column;padding-right:54px}.footer-pro-{{ section.id }} .footer-pro__payments{justify-content:flex-start}
  }
{% endstyle %}

{% liquid
  assign footer_phone = section.settings.footer_contact_phone
  assign footer_email = section.settings.footer_contact_email
  assign footer_address = section.settings.footer_contact_address
  if section.settings.use_shop_contact_info
    assign footer_phone = shop.phone
    assign footer_email = shop.email
  endif
  assign footer_phone_url = footer_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.'
%}

<footer class="footer-pro-{{ section.id }}">
  <div class="footer-pro__inner">
    {% if section.settings.show_trust_strip %}
      <div class="footer-pro__trust">
        <div class="footer-pro__trust-item"><span class="footer-pro__trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h11v11H3zM14 9h4l3 3v5h-7z"/><circle cx="7" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></svg></span><div><strong>Entrega acompanhada</strong><span>Consulte regiões e prazos no checkout</span></div></div>
        <div class="footer-pro__trust-item"><span class="footer-pro__trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l8 4v5c0 5-3.4 8-8 9-4.6-1-8-4-8-9V7z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg></span><div><strong>Compra protegida</strong><span>Checkout seguro processado pela Shopify</span></div></div>
        <div class="footer-pro__trust-item"><span class="footer-pro__trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 12a8 8 0 1 0 2.3-5.7L4 8.6"/><path d="M4 4v4.6h4.6"/></svg></span><div><strong>Atendimento dedicado</strong><span>Conte com nossa equipe quando precisar</span></div></div>
      </div>
    {% endif %}

    {% if section.settings.show_newsletter %}
      <div class="footer-pro__newsletter" data-reveal>
        <div><p class="footer-pro__eyebrow">{{ section.settings.newsletter_eyebrow | escape }}</p><h2 class="footer-pro__newsletter-title">{{ section.settings.newsletter_title | escape }}</h2><p class="footer-pro__newsletter-text">{{ section.settings.newsletter_text | escape }}</p></div>
        <div>
          {% form 'customer', class: 'footer-pro__newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="footer-pro__form"><input class="footer-pro__input" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ section.settings.newsletter_placeholder | escape }}" aria-label="Seu melhor e-mail" required><button class="footer-pro__submit" type="submit">{{ section.settings.newsletter_button | escape }} <span>→</span></button></div>
            {% if form.posted_successfully? %}<p class="footer-pro__form-message footer-pro__form-message--success">Cadastro realizado! Boas novidades estão a caminho.</p>{% endif %}
            {% if form.errors %}<div class="footer-pro__form-message footer-pro__form-message--error">{{ form.errors | default_errors }}</div>{% endif %}
          {% endform %}
        </div>
      </div>
    {% endif %}

    <div class="footer-pro__grid">
      <div class="footer-pro__brand">
        {% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 500 | image_tag: class: 'footer-pro__logo', loading: 'lazy' }}{% else %}<h2 class="footer-pro__brand-name">{{ shop.name | escape }}</h2>{% endif %}
        {% if section.settings.use_shop_description and shop.description != blank %}
          <div class="footer-pro__brand-text"><p>{{ shop.description | escape }}</p></div>
        {% elsif section.settings.brand_text != blank %}
          <div class="footer-pro__brand-text">{{ section.settings.brand_text }}</div>
        {% endif %}
        <div class="footer-pro__socials">
          {% if section.settings.footer_social_instagram != blank %}<a class="footer-pro__social" href="{{ section.settings.footer_social_instagram }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
          {% if section.settings.footer_social_facebook != blank %}<a class="footer-pro__social" href="{{ section.settings.footer_social_facebook }}" target="_blank" rel="noopener">Facebook</a>{% endif %}
          {% if section.settings.footer_social_tiktok != blank %}<a class="footer-pro__social" href="{{ section.settings.footer_social_tiktok }}" target="_blank" rel="noopener">TikTok</a>{% endif %}
          {% if section.settings.footer_social_youtube != blank %}<a class="footer-pro__social" href="{{ section.settings.footer_social_youtube }}" target="_blank" rel="noopener">YouTube</a>{% endif %}
          {% if section.settings.footer_social_whatsapp != blank %}<a class="footer-pro__social" href="{{ section.settings.footer_social_whatsapp }}" target="_blank" rel="noopener">WhatsApp</a>{% endif %}
        </div>
      </div>

      {% for block in section.blocks %}
        <div class="footer-pro__column" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title | escape }}</h3>
          {% case block.type %}
            {% when 'link_list' %}
              <ul>{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% else %}<li>Escolha um menu no editor</li>{% endfor %}</ul>
            {% when 'text' %}
              <div>{{ block.settings.text }}</div>
          {% endcase %}
        </div>
      {% endfor %}

      <div class="footer-pro__column">
        <h3>Fale conosco</h3>
        <div class="footer-pro__contact-list">
          {% if footer_phone != blank %}<div class="footer-pro__contact-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.7 19.7 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.7 19.7 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg><a href="tel:{{ footer_phone_url }}">{{ footer_phone | escape }}</a></div>{% endif %}
          {% if footer_email != blank %}<div class="footer-pro__contact-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><a href="mailto:{{ footer_email | escape }}">{{ footer_email | escape }}</a></div>{% endif %}
          {% if section.settings.use_shop_contact_info and shop.address != blank %}
            <div class="footer-pro__contact-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="2.5"/></svg><div>{{ shop.address | format_address }}</div></div>
          {% elsif footer_address != blank %}
            <div class="footer-pro__contact-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="2.5"/></svg><p>{{ footer_address | escape | newline_to_br }}</p></div>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="footer-pro__bottom">
      <div><p>{% if section.settings.use_dynamic_copyright or section.settings.footer_copyright == blank %}© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. Todos os direitos reservados.{% else %}{{ section.settings.footer_copyright | escape }}{% endif %}</p><button type="button" class="footer-pro__privacy-link" data-privacy-open>Preferências de privacidade</button></div>
      {% if section.settings.show_payment_icons %}
        <div class="footer-pro__payments" aria-label="Formas de pagamento">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{% else %}<span>Pagamento seguro</span>{% endfor %}</div>
      {% endif %}
    </div>
    {% if section.settings.show_back_to_top %}<button class="footer-pro__back-top" type="button" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="Voltar ao topo">↑</button>{% endif %}
  </div>
</footer>

{% schema %}
{
  "name": "Footer Lumina",
  "settings": [
    { "type": "header", "content": "Marca" },
    { "type": "image_picker", "id": "logo", "label": "Logo do rodapé" },
    { "type": "range", "id": "logo_width", "min": 80, "max": 280, "step": 10, "unit": "px", "label": "Largura da logo", "default": 180 },
    { "type": "checkbox", "id": "use_shop_description", "label": "Usar descrição cadastrada na Shopify", "default": true },
    { "type": "richtext", "id": "brand_text", "label": "Descrição da loja", "default": "<p>Produtos selecionados para surpreender, facilitar sua rotina e transformar cada compra em uma ótima experiência.</p>" },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Mostrar newsletter", "default": true },
    { "type": "text", "id": "newsletter_eyebrow", "label": "Chamada", "default": "Novidades em primeira mão" },
    { "type": "text", "id": "newsletter_title", "label": "Título", "default": "Descubra ofertas e lançamentos antes de todo mundo" },
    { "type": "text", "id": "newsletter_text", "label": "Descrição", "default": "Cadastre-se para receber novidades selecionadas, benefícios e condições especiais." },
    { "type": "text", "id": "newsletter_placeholder", "label": "Texto do campo", "default": "Digite seu melhor e-mail" },
    { "type": "text", "id": "newsletter_button", "label": "Texto do botão", "default": "Quero receber" },
    { "type": "header", "content": "Confiança" },
    { "type": "checkbox", "id": "show_trust_strip", "label": "Mostrar faixa de benefícios", "default": true },
    { "type": "header", "content": "Contato" },
    { "type": "checkbox", "id": "use_shop_contact_info", "label": "Usar dados cadastrados na Shopify", "default": true },
    { "type": "paragraph", "content": "Quando ativado, usa telefone, e-mail e endereço de Configurações > Informações da loja. Desative para preencher manualmente abaixo." },
    { "type": "text", "id": "footer_contact_phone", "label": "Telefone manual" },
    { "type": "text", "id": "footer_contact_email", "label": "E-mail manual" },
    { "type": "textarea", "id": "footer_contact_address", "label": "Endereço manual" },
    { "type": "header", "content": "Redes sociais" },
    { "type": "url", "id": "footer_social_facebook", "label": "Facebook" },
    { "type": "url", "id": "footer_social_instagram", "label": "Instagram" },
    { "type": "url", "id": "footer_social_twitter", "label": "Twitter" },
    { "type": "url", "id": "footer_social_youtube", "label": "YouTube" },
    { "type": "url", "id": "footer_social_tiktok", "label": "TikTok" },
    { "type": "url", "id": "footer_social_whatsapp", "label": "WhatsApp" },
    { "type": "header", "content": "Estilo" },
    { "type": "select", "id": "footer_columns", "label": "Número de colunas de menu", "options": [{ "value": "1", "label": "1 coluna" }, { "value": "2", "label": "2 colunas" }, { "value": "3", "label": "3 colunas" }, { "value": "4", "label": "4 colunas" }], "default": "2" },
    { "type": "range", "id": "max_width", "min": 1100, "max": 1900, "step": 100, "unit": "px", "label": "Largura máxima", "default": 1600 },
    { "type": "range", "id": "padding_bottom", "min": 30, "max": 100, "step": 10, "unit": "px", "label": "Espaçamento inferior", "default": 50 },
    { "type": "color", "id": "footer_bg", "label": "Cor de fundo", "default": "#060b14" },
    { "type": "color", "id": "footer_text", "label": "Cor principal", "default": "#ffffff" },
    { "type": "color", "id": "footer_link", "label": "Cor dos links", "default": "#aeb8c7" },
    { "type": "color", "id": "footer_link_hover", "label": "Links ao passar o mouse", "default": "#ffffff" },
    { "type": "color", "id": "accent", "label": "Cor de destaque", "default": "#135ee8" },
    { "type": "checkbox", "id": "use_dynamic_copyright", "label": "Usar nome da loja e ano atual", "default": true },
    { "type": "textarea", "id": "footer_copyright", "label": "Copyright personalizado", "info": "Desative a opção automática acima para usar este texto." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Mostrar meios de pagamento", "default": true },
    { "type": "checkbox", "id": "show_back_to_top", "label": "Mostrar botão voltar ao topo", "default": true }
  ],
  "blocks": [
    { "type": "link_list", "name": "Menu de links", "settings": [{ "type": "text", "id": "title", "label": "Título", "default": "Navegue" }, { "type": "link_list", "id": "menu", "label": "Menu" }] },
    { "type": "text", "name": "Texto", "settings": [{ "type": "text", "id": "title", "label": "Título", "default": "Sobre" }, { "type": "richtext", "id": "text", "label": "Conteúdo", "default": "<p>Adicione informações importantes sobre sua loja.</p>" }] }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Footer Lumina", "category": "Rodapé", "blocks": [{ "type": "link_list" }, { "type": "link_list" }] }]
}
{% endschema %}
