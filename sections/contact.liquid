<section class="contact-page" style="max-width: var(--container-width); margin: var(--spacing-lg) auto; padding: 0 var(--spacing-sm);">
  <h1 class="section-title">{{ 'contact.title' | t }}</h1>
  
  <div class="contact-page__grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem;">
    <!-- Contact Form -->
    <div class="contact-form" style="background: #fff; padding: 2rem; border-radius: var(--radius-md); border: 1px solid var(--color-border); box-shadow: var(--shadow-card);">
      {% form 'contact' %}
        {% if form.posted_successfully %}
          <div class="contact-form__success" style="background: #d4edda; color: #155724; padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">
            {{ 'contact.success_message' | t }}
          </div>
        {% endif %}
        
        {% if form.errors %}
          <div class="contact-form__error" style="background: #f8d7da; color: #721c24; padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">
            {{ 'contact.error_message' | t }}
          </div>
        {% endif %}
        
        <div class="contact-form__field" style="margin-bottom: 1.5rem;">
          <label for="contact-name" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">
            {{ 'contact.name' | t }} *
          </label>
          <input 
            type="text" 
            id="contact-name" 
            name="contact[name]" 
            required
            style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-family: var(--font-body);"
          >
        </div>
        
        <div class="contact-form__field" style="margin-bottom: 1.5rem;">
          <label for="contact-email" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">
            {{ 'contact.email' | t }} *
          </label>
          <input 
            type="email" 
            id="contact-email" 
            name="contact[email]" 
            required
            style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-family: var(--font-body);"
          >
        </div>
        
        <div class="contact-form__field" style="margin-bottom: 1.5rem;">
          <label for="contact-message" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">
            {{ 'contact.message' | t }} *
          </label>
          <textarea 
            id="contact-message" 
            name="contact[body]" 
            rows="5" 
            required
            style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-family: var(--font-body); resize: vertical;"
          ></textarea>
        </div>
        
        <button type="submit" class="button" style="width: 100%;">
          {{ 'contact.send' | t }}
        </button>
      {% endform %}
    </div>
    
    <!-- Contact Info -->
    <div class="contact-info">
      <div class="contact-info__card" style="background: #fff; padding: 2rem; border-radius: var(--radius-md); border: 1px solid var(--color-border); margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 1rem;">Informações de Contato</h3>
        
        {% if shop.email %}
          <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M22 6l-10 7L2 6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <a href="mailto:{{ shop.email }}" style="color: var(--color-text-primary); text-decoration: none;">
              {{ shop.email }}
            </a>
          </div>
        {% endif %}
        
        {% if shop.address %}
          <div style="display: flex; align-items: flex-start; gap: 0.75rem; margin-bottom: 1rem;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="12" cy="10" r="3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span style="color: var(--color-text-primary);">{{ shop.address }}</span>
          </div>
        {% endif %}
        
        {% if shop.phone %}
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <a href="tel:{{ shop.phone }}" style="color: var(--color-text-primary); text-decoration: none;">
              {{ shop.phone }}
            </a>
          </div>
        {% endif %}
      </div>
      
      <div class="contact-info__hours" style="background: #fff; padding: 2rem; border-radius: var(--radius-md); border: 1px solid var(--color-border);">
        <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 1rem;">Horário de Atendimento</h3>
        <div style="color: var(--color-text-primary); line-height: 1.8;">
          <p>Segunda a Sexta: 9h - 18h</p>
          <p>Sábado: 9h - 14h</p>
          <p>Domingo: Fechado</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Página de Contato",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Entre em Contato"
    }
  ]
}
{% endschema %}
