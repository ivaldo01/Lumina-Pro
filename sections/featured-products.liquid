    { "type": "checkbox", "id": "compact_mobile", "label": "Ocultar detalhes secundários no celular", "default": true },
    { "type": "checkbox", "id": "show_secondary_image", "label": "Mostrar segunda imagem ao passar o mouse", "default": true },
    { "type": "checkbox", "id": "show_wishlist", "label": "Mostrar favoritos", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "Mostrar marca", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "Mostrar avaliações reais quando disponíveis", "default": false },
    { "type": "checkbox", "id": "show_badge", "label": "Mostrar selo de oferta", "default": true },
    { "type": "text", "id": "badge_text", "label": "Texto do selo", "default": "Oferta" },
    { "type": "checkbox", "id": "show_pix_text", "label": "Mostrar informação de PIX", "default": true },
    { "type": "text", "id": "pix_text", "label": "Texto do PIX", "default": "Preço especial à vista no PIX" },
    { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "Adicionar" },
    { "type": "checkbox", "id": "show_footer_cta", "label": "Mostrar botão ao final da vitrine", "default": true },
    { "type": "text", "id": "footer_cta_label", "label": "Texto do botão final", "default": "Explorar todos os produtos" },
    { "type": "header", "content": "Imagens" },
    { "type": "select", "id": "image_ratio", "label": "Proporção", "options": [{ "value": "1 / 1", "label": "Quadrada" }, { "value": "4 / 5", "label": "Retrato" }, { "value": "3 / 4", "label": "Retrato alto" }], "default": "1 / 1" },
    { "type": "select", "id": "image_fit", "label": "Enquadramento", "options": [{ "value": "contain", "label": "Mostrar produto inteiro" }, { "value": "cover", "label": "Preencher imagem" }], "default": "contain" },
    { "type": "color", "id": "media_background", "label": "Fundo das imagens", "default": "#f5f6f8" },
    { "type": "range", "id": "media_radius", "min": 0, "max": 30, "step": 2, "unit": "px", "label": "Arredondamento da imagem", "default": 14 },
    { "type": "header", "content": "Estilo dos cards" },
    { "type": "range", "id": "max_width", "min": 1000, "max": 2000, "step": 100, "unit": "px", "label": "Largura máxima", "default": 1600 },
    { "type": "range", "id": "grid_gap", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Espaço entre cards", "default": 22 },
    { "type": "range", "id": "card_padding", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Espaçamento interno", "default": 12 },
    { "type": "range", "id": "card_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Arredondamento dos cards", "default": 18 },
    { "type": "range", "id": "button_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Arredondamento dos botões", "default": 10 },
    { "type": "color", "id": "section_bg", "label": "Fundo da seção", "default": "#f7f8fa" },
    { "type": "color", "id": "card_background", "label": "Fundo dos cards", "default": "#ffffff" },
    { "type": "color", "id": "card_border", "label": "Borda dos cards", "default": "#e8ebf0" },
    { "type": "color", "id": "card_text", "label": "Texto dos cards", "default": "#111827" },
    { "type": "color", "id": "heading_color", "label": "Título da seção", "default": "#111827" },
    { "type": "color", "id": "accent_color", "label": "Cor de destaque", "default": "#135ee8" },
    { "type": "color", "id": "price_color", "label": "Preço", "default": "#111827" },
    { "type": "color", "id": "badge_color", "label": "Selo", "default": "#135ee8" },
    { "type": "color", "id": "button_color", "label": "Botão", "default": "#111827" },
    { "type": "color", "id": "button_text_color", "label": "Texto do botão", "default": "#ffffff" },
    { "type": "header", "content": "Espaçamentos" },
    { "type": "range", "id": "padding_y", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Vertical no computador", "default": 90 },
