<style>
  .hero-slider-{{ section.id }} {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    gap: 0;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
  }
  .hero-slider-{{ section.id }}::-webkit-scrollbar { display: none; }

  .hero-slider-{{ section.id }} .hero-slide {
    flex: 0 0 100%;
    width: 100%;
    scroll-snap-align: center;
    position: relative;
    overflow: hidden;
    background: #f5f5f5;
    display: block;
    height: {{ section.settings.desktop_height }}px;
  }
  .hero-slider-{{ section.id }} .hero-slide img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: center;
    display: block;
  }
  @media (max-width: 768px) {
    .hero-slider-{{ section.id }} .hero-slide {
      height: {{ section.settings.mobile_height }}px;
    }
  }
</style>

<section class="hero-slider-{{ section.id }}">
  {% for block in section.blocks %}
    <a href="{{ block.settings.link | default: '#' }}" class="hero-slide" {{ block.shopify_attributes }}>
      {% if block.settings.image != blank %}
        <img src="{{ block.settings.image | image_url: width: 2000 }}"
             alt="{{ block.settings.image.alt | escape }}"
             loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
      {% else %}
        <div style="width:100%;height:100%;background:#333;display:flex;align-items:center;justify-content:center;color:#fff;">
          Banner de Exemplo {{ forloop.index }}
        </div>
      {% endif %}
    </a>
  {% endfor %}

  {% if section.blocks.size == 0 %}
    <div class="hero-slide">
      <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=2070&auto=format&fit=crop" alt="Oferta Tech" loading="eager">
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Slider de Banners (Pro)",
  "max_blocks": 5,
  "settings": [
    { "type": "header", "content": "Altura do Banner" },
    {
      "type": "range", "id": "desktop_height",
      "min": 200, "max": 1000, "step": 25, "unit": "px",
      "label": "Altura no Computador", "default": 500
    },
    {
      "type": "range", "id": "mobile_height",
      "min": 150, "max": 800, "step": 25, "unit": "px",
      "label": "Altura no Celular", "default": 300
    },
    {
      "type": "select", "id": "image_fit",
      "label": "Comportamento da Imagem",
      "options": [
        { "value": "cover", "label": "Preencher tela (Pode cortar as bordas)" },
        { "value": "contain", "label": "Encaixar (Mostra a imagem inteira)" }
      ],
      "default": "cover"
    }
  ],
  "blocks": [
    {
      "type": "slide", "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem do Banner" },
        { "type": "url", "id": "link", "label": "Link do Banner" }
      ]
    }
  ],
  "presets": [
    { "name": "Slider de Banners Lumina", "category": "Image", "blocks": [ { "type": "slide" } ] }
  ]
}
{% endschema %}
