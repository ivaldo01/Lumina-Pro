{% style %}
  .benefits-{{ section.id }}{background:{{ section.settings.background }};color:{{ section.settings.text_color }};border-block:1px solid {{ section.settings.border_color }}}
  .benefits-{{ section.id }} .benefits__inner{max-width:{{ section.settings.max_width }}px;margin:auto;display:grid;grid-template-columns:repeat({{ section.blocks.size }},minmax(0,1fr));padding:{{ section.settings.padding_y }}px clamp(1rem,4vw,3rem)}
  .benefits-{{ section.id }} .benefit{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:1rem;padding:clamp(.75rem,2vw,1.5rem)}
  .benefits-{{ section.id }} .benefit+.benefit{border-left:1px solid {{ section.settings.border_color }}}
  .benefits-{{ section.id }} .benefit__icon{display:grid;place-items:center;width:48px;height:48px;border-radius:{{ section.settings.icon_radius }}px;background:{{ section.settings.icon_background }};color:{{ section.settings.icon_color }};font-size:1.35rem;transition:transform .35s cubic-bezier(.2,.8,.2,1)}
  .benefits-{{ section.id }} .benefit:hover .benefit__icon{transform:translateY(-4px) rotate(-4deg)}
  .benefits-{{ section.id }} h3{margin:0 0 .2rem;color:inherit;font-size:.93rem}
  .benefits-{{ section.id }} p{margin:0;opacity:.68;font-size:.82rem;line-height:1.45}
  @media(max-width:900px){.benefits-{{ section.id }} .benefits__inner{grid-template-columns:repeat(2,1fr)}.benefits-{{ section.id }} .benefit:nth-child(odd){border-left:0}.benefits-{{ section.id }} .benefit:nth-child(n+3){border-top:1px solid {{ section.settings.border_color }}}}
  @media(max-width:520px){
    .benefits-{{ section.id }} .benefits__inner{
      display:grid;
      grid-template-columns:repeat({{ section.settings.mobile_columns }},minmax(0,1fr));
      gap:{{ section.settings.mobile_gap }}px;
      padding:{{ section.settings.mobile_padding_y }}px 14px;
    }
    .benefits-{{ section.id }} .benefit{
      min-width:0;
      padding:{{ section.settings.mobile_card_padding }}px;
      border:1px solid {{ section.settings.border_color }}!important;
      border-radius:{{ section.settings.mobile_card_radius }}px;
      background:{{ section.settings.mobile_card_background }};
      {% if section.settings.mobile_columns == '2' %}
        grid-template-columns:1fr;
        align-content:start;
        text-align:center;
        gap:.7rem;
      {% else %}
        grid-template-columns:auto minmax(0,1fr);
      {% endif %}
    }
    .benefits-{{ section.id }} .benefit__icon{
      width:44px;
      height:44px;
      {% if section.settings.mobile_columns == '2' %}margin:0 auto;{% endif %}
    }
    .benefits-{{ section.id }} h3{font-size:.84rem;line-height:1.3}
    .benefits-{{ section.id }} p{font-size:.76rem;line-height:1.4;overflow-wrap:anywhere}
  }
{% endstyle %}

<section class="benefits-{{ section.id }}" aria-label="{{ section.settings.accessibility_label | escape }}">
  <div class="benefits__inner">
    {% for block in section.blocks %}
      <article class="benefit" data-reveal {{ block.shopify_attributes }}>
        <div class="benefit__icon" aria-hidden="true">
          {% case block.settings.icon %}
            {% when 'truck' %}↗
            {% when 'shield' %}◇
            {% when 'refresh' %}↻
            {% when 'chat' %}◎
            {% when 'gift' %}✦
            {% else %}✓
          {% endcase %}
        </div>
        <div><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape }}</p></div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Benefícios premium",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "accessibility_label", "label": "Descrição acessível", "default": "Vantagens da loja" },
    { "type": "range", "id": "max_width", "min": 1000, "max": 2000, "step": 100, "unit": "px", "label": "Largura máxima", "default": 1600 },
    { "type": "range", "id": "padding_y", "min": 10, "max": 60, "step": 5, "unit": "px", "label": "Espaçamento vertical", "default": 20 },
    { "type": "color", "id": "background", "label": "Fundo", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Texto", "default": "#111827" },
    { "type": "color", "id": "border_color", "label": "Divisórias", "default": "#e7e9ee" },
    { "type": "color", "id": "icon_background", "label": "Fundo dos ícones", "default": "#f1f5ff" },
    { "type": "color", "id": "icon_color", "label": "Cor dos ícones", "default": "#135ee8" },
    { "type": "range", "id": "icon_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Arredondamento dos ícones", "default": 14 }
    ,
    { "type": "header", "content": "Layout no celular" },
    { "type": "select", "id": "mobile_columns", "label": "Colunas", "options": [{ "value": "1", "label": "1 coluna" }, { "value": "2", "label": "2 colunas" }], "default": "2" },
    { "type": "range", "id": "mobile_gap", "min": 6, "max": 24, "step": 2, "unit": "px", "label": "Espaço entre cards", "default": 10 },
    { "type": "range", "id": "mobile_padding_y", "min": 10, "max": 50, "step": 5, "unit": "px", "label": "Espaçamento vertical", "default": 20 },
    { "type": "range", "id": "mobile_card_padding", "min": 10, "max": 30, "step": 2, "unit": "px", "label": "Espaçamento interno", "default": 14 },
    { "type": "range", "id": "mobile_card_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Arredondamento dos cards", "default": 14 },
    { "type": "color", "id": "mobile_card_background", "label": "Fundo dos cards", "default": "#ffffff" }
  ],
  "blocks": [{
    "type": "benefit", "name": "Benefício",
    "settings": [
      { "type": "select", "id": "icon", "label": "Ícone", "options": [{ "value": "truck", "label": "Entrega" }, { "value": "shield", "label": "Segurança" }, { "value": "refresh", "label": "Troca" }, { "value": "chat", "label": "Atendimento" }, { "value": "gift", "label": "Presente" }, { "value": "check", "label": "Confirmação" }], "default": "truck" },
      { "type": "text", "id": "heading", "label": "Título", "default": "Envio para todo o Brasil" },
      { "type": "text", "id": "text", "label": "Descrição", "default": "Rastreamento em todas as etapas" }
    ]
  }],
  "presets": [{
    "name": "Benefícios premium", "category": "Premium",
    "blocks": [
      { "type": "benefit", "settings": { "icon": "truck", "heading": "Envio nacional", "text": "Rastreamento em todas as etapas" } },
      { "type": "benefit", "settings": { "icon": "shield", "heading": "Compra protegida", "text": "Pagamento seguro e criptografado" } },
      { "type": "benefit", "settings": { "icon": "refresh", "heading": "Troca simplificada", "text": "Atendimento rápido e sem complicação" } },
      { "type": "benefit", "settings": { "icon": "chat", "heading": "Suporte humano", "text": "Equipe pronta para ajudar você" } }
    ]
  }]
}
{% endschema %}
