{% style %}
  .list-collections-{{ section.id }}{padding:clamp(2rem,6vw,6rem) clamp(1rem,3vw,2.5rem);background:{{ section.settings.background }}}
  .list-collections-{{ section.id }} .list-collections__inner{width:min(100%,{{ section.settings.max_width }}px);margin:auto}
  .list-collections-{{ section.id }} .list-collections__header{max-width:760px;margin-bottom:clamp(2rem,4vw,3.5rem)}
  .list-collections-{{ section.id }} .list-collections__eyebrow{color:{{ section.settings.accent }};font-size:.7rem;font-weight:850;letter-spacing:.16em;text-transform:uppercase}
  .list-collections-{{ section.id }} .list-collections__title{margin:.45rem 0 0;font-size:clamp(2rem,5vw,3.8rem);letter-spacing:-.045em}
  .list-collections-{{ section.id }} .list-collections__grid{display:grid;grid-template-columns:repeat({{ section.settings.columns }},minmax(0,1fr));gap:clamp(1rem,2vw,1.5rem)}
  .list-collections-{{ section.id }} .collection-tile{position:relative;min-height:360px;overflow:hidden;border-radius:22px;background:#071329;color:#fff}
  .list-collections-{{ section.id }} .collection-tile__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .7s cubic-bezier(.2,.8,.2,1)}
  .list-collections-{{ section.id }} .collection-tile::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 35%,rgba(3,10,24,.92))}
  .list-collections-{{ section.id }} .collection-tile__content{position:absolute;z-index:1;right:0;bottom:0;left:0;padding:1.5rem}
  .list-collections-{{ section.id }} .collection-tile h2{margin:0;color:#fff;font-size:1.4rem}.list-collections-{{ section.id }} .collection-tile p{margin:.4rem 0 0;color:rgba(255,255,255,.7);font-size:.75rem}
  .list-collections-{{ section.id }} .collection-tile:hover .collection-tile__image{transform:scale(1.06)}
  @media(max-width:990px){.list-collections-{{ section.id }} .list-collections__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){.list-collections-{{ section.id }} .list-collections__grid{grid-template-columns:1fr}.list-collections-{{ section.id }} .collection-tile{min-height:290px}}
{% endstyle %}

<section class="list-collections-{{ section.id }}">
  <div class="list-collections__inner">
    <header class="list-collections__header" data-reveal><p class="list-collections__eyebrow">{{ section.settings.eyebrow | escape }}</p><h1 class="list-collections__title">{{ section.settings.heading | escape }}</h1></header>
    <div class="list-collections__grid">
      {% for collection in collections %}
        {% unless collection.handle == 'frontpage' %}
          <a class="collection-tile" href="{{ collection.url }}" data-reveal>
            {% if collection.featured_image %}{{ collection.featured_image | image_url: width: 900 | image_tag: class: 'collection-tile__image', loading: 'lazy', widths: '360, 540, 720, 900' }}{% endif %}
            <div class="collection-tile__content"><h2>{{ collection.title | escape }}</h2><p>{{ collection.products_count }} produtos</p></div>
          </a>
        {% endunless %}
      {% else %}
        <p>Nenhuma coleção publicada.</p>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{"name":"Lista de coleções","settings":[{"type":"text","id":"eyebrow","label":"Chamada","default":"Explore por categoria"},{"type":"text","id":"heading","label":"Título","default":"Todas as coleções"},{"type":"range","id":"columns","min":2,"max":4,"step":1,"label":"Colunas","default":3},{"type":"range","id":"max_width","min":1000,"max":1800,"step":100,"unit":"px","label":"Largura máxima","default":1500},{"type":"color","id":"background","label":"Fundo","default":"#f5f7fa"},{"type":"color","id":"accent","label":"Destaque","default":"#135ee8"}]}
{% endschema %}
