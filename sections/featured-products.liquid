    { "type": "select", "id": "title_alignment", "label": "Alinhamento", "options": [{ "value": "flex-start", "label": "Esquerda" }, { "value": "center", "label": "Centro" }, { "value": "flex-end", "label": "Direita" }], "default": "flex-start" },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar link Ver todos", "default": true },
