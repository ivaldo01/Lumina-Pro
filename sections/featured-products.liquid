<script src="{{ 'product-cards.js' | asset_url }}" defer="defer"></script>

{% style %}
  .featured-pro-{{ section.id }}{
    --card-radius:{{ section.settings.card_radius }}px;
    --media-radius:{{ section.settings.media_radius }}px;
    --grid-gap:{{ section.settings.grid_gap }}px;
    padding:{{ section.settings.padding_y }}px clamp(1rem,4vw,3rem);
    background:{{ section.settings.section_bg }};
    position:relative;overflow:hidden
  }
  .featured-pro-{{ section.id }}::before,.featured-pro-{{ section.id }}::after{content:"";position:absolute;width:420px;height:420px;border-radius:50%;pointer-events:none;filter:blur(90px);opacity:.11}
  .featured-pro-{{ section.id }}::before{top:-220px;right:-140px;background:{{ section.settings.accent_color }}}
  .featured-pro-{{ section.id }}::after{bottom:-260px;left:-180px;background:{{ section.settings.badge_color }}}
  .featured-pro-{{ section.id }} .featured-pro__inner{max-width:{{ section.settings.max_width }}px;margin:auto}
  .featured-pro-{{ section.id }} .featured-pro__header{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:clamp(2rem,5vw,4rem);text-align:{% case section.settings.title_alignment %}{% when 'flex-start' %}left{% when 'flex-end' %}right{% else %}center{% endcase %}}
  .featured-pro-{{ section.id }} .featured-pro__heading-wrap{width:100%}
  .featured-pro-{{ section.id }} .featured-pro__eyebrow{margin:0 0 .6rem;color:{{ section.settings.accent_color }};font-size:.72rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase}
  .featured-pro-{{ section.id }} .featured-pro__title{margin:0;color:{{ section.settings.heading_color }};font-size:clamp(1.8rem,4vw,3rem);letter-spacing:-.04em;text-transform:none}
  .featured-pro-{{ section.id }} .featured-pro__subtitle{max-width:600px;margin:.8rem {% if section.settings.title_alignment == 'center' %}auto{% elsif section.settings.title_alignment == 'flex-end' %}0 0 auto{% else %}0{% endif %};color:var(--color-text-secondary);line-height:1.65}
  .featured-pro-{{ section.id }} .featured-pro__view-all{flex-shrink:0;padding-bottom:.35rem;border-bottom:1px solid currentColor;font-size:.85rem;font-weight:800;white-space:nowrap}
  .featured-pro-{{ section.id }} .featured-pro__meta{display:flex;align-items:center;gap:.65rem;margin-top:1rem;color:#657083;font-size:.75rem;font-weight:650}
  .featured-pro-{{ section.id }} .featured-pro__meta-dot{width:7px;height:7px;border-radius:50%;background:{{ section.settings.accent_color }};box-shadow:0 0 0 5px {{ section.settings.accent_color | color_modify: 'alpha', 0.12 }}}
  .featured-pro-{{ section.id }} .featured-pro__benefits{position:relative;z-index:1;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin:-1.5rem 0 clamp(2rem,4vw,3.25rem);overflow:hidden;border:1px solid {{ section.settings.card_border }};border-radius:18px;background:{{ section.settings.card_background }};box-shadow:0 18px 55px rgba(15,23,42,.07)}
  .featured-pro-{{ section.id }} .featured-pro__benefit{display:flex;align-items:center;gap:1rem;padding:1.15rem 1.35rem}
  .featured-pro-{{ section.id }} .featured-pro__benefit+.featured-pro__benefit{border-left:1px solid {{ section.settings.card_border }}}
  .featured-pro-{{ section.id }} .featured-pro__benefit-icon{display:grid;flex:0 0 42px;place-items:center;width:42px;height:42px;border-radius:13px;background:{{ section.settings.accent_color | color_modify: 'alpha', 0.09 }};color:{{ section.settings.accent_color }}}
  .featured-pro-{{ section.id }} .featured-pro__benefit-icon svg{width:21px;height:21px}
  .featured-pro-{{ section.id }} .featured-pro__benefit strong{display:block;color:{{ section.settings.card_text }};font-size:.78rem}
  .featured-pro-{{ section.id }} .featured-pro__benefit span{display:block;margin-top:.2rem;color:#6b7280;font-size:.68rem;line-height:1.4}
  .featured-pro-{{ section.id }} .featured-pro__grid{display:grid;grid-template-columns:repeat({{ section.settings.columns_desktop }},minmax(0,1fr));gap:var(--grid-gap);align-items:start}
  .featured-pro-{{ section.id }} .product-pro{position:relative;display:flex;min-width:0;flex-direction:column;padding:{{ section.settings.card_padding }}px;border:1px solid {{ section.settings.card_border }};border-radius:var(--card-radius);background:{{ section.settings.card_background }};box-shadow:0 8px 30px rgba(15,23,42,.04);transition:transform .45s cubic-bezier(.2,.8,.2,1),box-shadow .45s ease,border-color .35s ease}
  .featured-pro-{{ section.id }} .product-pro::before{content:"";position:absolute;inset:-1px;border-radius:inherit;background:linear-gradient(135deg,transparent 35%,{{ section.settings.accent_color | color_modify: 'alpha', 0.22 }},transparent 68%);opacity:0;z-index:-1;transition:opacity .4s ease}
  .featured-pro-{{ section.id }} .product-pro::after{content:"";position:absolute;z-index:2;top:0;left:-120%;width:55%;height:100%;pointer-events:none;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);transform:skewX(-18deg);transition:left .8s ease}
  .featured-pro-{{ section.id }} .product-pro:hover{transform:translateY(-10px);border-color:{{ section.settings.accent_color | color_modify: 'alpha', 0.38 }};box-shadow:0 24px 55px rgba(15,23,42,.13)}
  .featured-pro-{{ section.id }} .product-pro:hover::before{opacity:1}
  .featured-pro-{{ section.id }} .product-pro:hover::after{left:145%}
  .featured-pro-{{ section.id }} .product-pro__media{position:relative;display:block;overflow:hidden;border-radius:var(--media-radius);background:{{ section.settings.media_background }};aspect-ratio:{{ section.settings.image_ratio }}}
  .featured-pro-{{ section.id }} .product-pro__image{position:absolute;inset:0;width:100%;height:100%;object-fit:{{ section.settings.image_fit }};transition:transform .75s cubic-bezier(.2,.8,.2,1),opacity .45s ease}
  .featured-pro-{{ section.id }} .product-pro__image--secondary{opacity:0}
  .featured-pro-{{ section.id }} .product-pro:hover .product-pro__image--primary{transform:scale(1.06);{% if section.settings.show_secondary_image %}opacity:0{% endif %}}
  .featured-pro-{{ section.id }} .product-pro:hover .product-pro__image--secondary{opacity:1;transform:scale(1.04)}
  .featured-pro-{{ section.id }} .product-pro__badges{position:absolute;z-index:3;top:12px;left:12px;display:flex;flex-wrap:wrap;gap:.4rem}
  .featured-pro-{{ section.id }} .product-pro__badge{padding:.4rem .65rem;border-radius:999px;background:{{ section.settings.badge_color }};color:#fff;font-size:.62rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase;box-shadow:0 6px 18px rgba(0,0,0,.14)}
  .featured-pro-{{ section.id }} .product-pro__discount{background:#fff;color:#111}
  .featured-pro-{{ section.id }} .product-pro__wishlist{position:absolute;z-index:4;top:12px;right:12px;display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:rgba(255,255,255,.9);box-shadow:0 5px 20px rgba(15,23,42,.1);backdrop-filter:blur(8px);transition:transform .25s ease}
  .featured-pro-{{ section.id }} .product-pro__wishlist:hover{transform:scale(1.1)}
  .featured-pro-{{ section.id }} .product-pro__content{display:flex;flex:1;flex-direction:column;padding:1.25rem .25rem .2rem}
  .featured-pro-{{ section.id }} .product-pro__vendor{margin:0 0 .45rem;color:{{ section.settings.accent_color }};font-size:.65rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .featured-pro-{{ section.id }} .product-pro__title{display:-webkit-box;overflow:hidden;min-height:2.7em;margin:0;color:{{ section.settings.card_text }};font-size:.92rem;font-weight:650;line-height:1.45;-webkit-box-orient:vertical;-webkit-line-clamp:2;transition:color .25s ease}
  .featured-pro-{{ section.id }} .product-pro:hover .product-pro__title{color:{{ section.settings.accent_color }}}
  .featured-pro-{{ section.id }} .product-pro__rating{display:flex;align-items:center;gap:.45rem;margin:.7rem 0;color:#f4a620;font-size:.72rem}
  .featured-pro-{{ section.id }} .product-pro__rating span{color:var(--color-text-secondary)}
  .featured-pro-{{ section.id }} .product-pro__price{display:flex;align-items:baseline;flex-wrap:wrap;gap:.55rem;padding-top:1rem}
  .featured-pro-{{ section.id }} .product-pro__price-current{color:{{ section.settings.price_color }};font-size:1.25rem;font-weight:850;letter-spacing:-.025em}
  .featured-pro-{{ section.id }} .product-pro__price-old{color:#9299a6;font-size:.78rem;text-decoration:line-through}
  .featured-pro-{{ section.id }} .product-pro__pix{margin:.28rem 0 0;color:#5d6675;font-size:.72rem}
  .featured-pro-{{ section.id }} .product-pro__actions{display:grid;grid-template-columns:1fr auto;gap:.55rem;margin-top:1rem}
  .featured-pro-{{ section.id }} .product-pro__button{display:flex;align-items:center;justify-content:center;min-height:46px;padding:.7rem 1rem;border:0;border-radius:{{ section.settings.button_radius }}px;background:{{ section.settings.button_color }};color:{{ section.settings.button_text_color }};font:inherit;font-size:.72rem;font-weight:850;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;transition:transform .25s ease,filter .25s ease,box-shadow .25s ease}
  .featured-pro-{{ section.id }} .product-pro__button:hover{transform:translateY(-2px);filter:brightness(1.08);box-shadow:0 10px 24px {{ section.settings.button_color | color_modify: 'alpha', 0.28 }}}
  .featured-pro-{{ section.id }} .product-pro__button[disabled]{opacity:.5;cursor:not-allowed}
  .featured-pro-{{ section.id }} .product-pro__view{display:grid;place-items:center;width:46px;height:46px;border:1px solid {{ section.settings.card_border }};border-radius:{{ section.settings.button_radius }}px;color:{{ section.settings.card_text }};transition:.25s ease}
  .featured-pro-{{ section.id }} .product-pro__view:hover{border-color:{{ section.settings.accent_color }};background:{{ section.settings.accent_color }};color:#fff;transform:translateY(-2px)}
  .featured-pro-{{ section.id }} .placeholder-svg{width:100%;height:100%;background:#eef1f5}
  .featured-pro-{{ section.id }} .product-spotlight{position:relative;display:grid;grid-column:1/-1;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);justify-self:center;width:min(100%,1000px);height:310px;margin:clamp(.75rem,2vw,1.5rem) auto;overflow:hidden;border-radius:22px;background:var(--spotlight-bg);color:var(--spotlight-text);box-shadow:0 20px 50px rgba(15,23,42,.14);isolation:isolate}
  .featured-pro-{{ section.id }} .product-spotlight::before{content:"";position:absolute;z-index:-1;width:420px;height:420px;border-radius:50%;background:var(--spotlight-accent);filter:blur(110px);opacity:.34;right:-120px;bottom:-220px}
  .featured-pro-{{ section.id }} .product-spotlight--reverse .product-spotlight__media{order:2}
  .featured-pro-{{ section.id }} .product-spotlight__media{position:relative;min-height:0;overflow:hidden;background:rgba(255,255,255,.06)}
  .featured-pro-{{ section.id }} .product-spotlight__media::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent 62%,var(--spotlight-bg))}
  .featured-pro-{{ section.id }} .product-spotlight--reverse .product-spotlight__media::after{background:linear-gradient(270deg,transparent 62%,var(--spotlight-bg))}
  .featured-pro-{{ section.id }} .product-spotlight__image{width:100%;height:100%;object-fit:var(--spotlight-fit,contain);object-position:var(--spotlight-position,center);transition:transform 1.1s cubic-bezier(.2,.8,.2,1)}
  .featured-pro-{{ section.id }} .product-spotlight:hover .product-spotlight__image{transform:scale(1.055)}
  .featured-pro-{{ section.id }} .product-spotlight__content{display:flex;align-items:flex-start;justify-content:center;flex-direction:column;padding:clamp(1.35rem,3vw,2.5rem)}
  .featured-pro-{{ section.id }} .product-spotlight__eyebrow{margin:0 0 .65rem;color:var(--spotlight-accent);font-size:.7rem;font-weight:900;letter-spacing:.18em;text-transform:uppercase}
  .featured-pro-{{ section.id }} .product-spotlight__title{max-width:620px;margin:0;color:inherit;font-size:clamp(1.45rem,2.5vw,2.15rem);line-height:1.04;letter-spacing:-.04em}
  .featured-pro-{{ section.id }} .product-spotlight__text{max-width:530px;margin:.65rem 0 0;color:color-mix(in srgb,var(--spotlight-text) 72%,transparent);font-size:.82rem;line-height:1.5}
  .featured-pro-{{ section.id }} .product-spotlight__price{display:flex;align-items:baseline;gap:.75rem;margin-top:.75rem}
  .featured-pro-{{ section.id }} .product-spotlight__price strong{font-size:1.55rem}
  .featured-pro-{{ section.id }} .product-spotlight__price s{opacity:.55;font-size:.85rem}
  .featured-pro-{{ section.id }} .product-spotlight__button{display:inline-flex;align-items:center;gap:.7rem;margin-top:.8rem;padding:.72rem 1.1rem;border-radius:999px;background:var(--spotlight-accent);color:#fff;font-size:.68rem;font-weight:850;letter-spacing:.04em;transition:transform .3s ease,box-shadow .3s ease}
  .featured-pro-{{ section.id }} .product-spotlight__button:hover{transform:translateY(-3px);box-shadow:0 14px 32px color-mix(in srgb,var(--spotlight-accent) 38%,transparent)}
  .spotlight-motion-ready .featured-pro-{{ section.id }} .product-spotlight[data-spotlight-reveal]{opacity:0;transform:translate3d(110px,18px,0) scale(.94) rotateY(-5deg);filter:blur(5px);transition:opacity .7s ease,transform 1s cubic-bezier(.16,1,.3,1),filter .7s ease}
  .spotlight-motion-ready .featured-pro-{{ section.id }} .product-spotlight[data-spotlight-reveal].is-active{opacity:1;transform:translate3d(0,0,0) scale(1) rotateY(0);filter:blur(0)}
  .spotlight-motion-ready .featured-pro-{{ section.id }} .product-spotlight[data-spotlight-reveal].is-past{opacity:0;transform:translate3d(-90px,-15px,0) scale(.96) rotateY(4deg);filter:blur(4px)}
  .featured-pro-{{ section.id }} .featured-pro__footer{display:flex;align-items:center;justify-content:center;margin-top:clamp(2rem,4vw,3.5rem)}
  .featured-pro-{{ section.id }} .featured-pro__footer-link{display:inline-flex;align-items:center;gap:.8rem;min-height:52px;padding:.8rem 1.5rem;border:1px solid {{ section.settings.accent_color }};border-radius:999px;background:{{ section.settings.accent_color }};color:#fff;font-size:.78rem;font-weight:850;letter-spacing:.04em;box-shadow:0 12px 30px {{ section.settings.accent_color | color_modify: 'alpha', 0.24 }};transition:transform .3s ease,box-shadow .3s ease}
  .featured-pro-{{ section.id }} .featured-pro__footer-link:hover{transform:translateY(-3px);box-shadow:0 18px 38px {{ section.settings.accent_color | color_modify: 'alpha', 0.34 }}}
  .featured-pro-{{ section.id }} .featured-pro__footer-link span{transition:transform .3s ease}.featured-pro-{{ section.id }} .featured-pro__footer-link:hover span{transform:translateX(4px)}
  @media(max-width:990px){.featured-pro-{{ section.id }} .featured-pro__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:749px){
    .featured-pro-{{ section.id }}{--grid-gap:{{ section.settings.mobile_gap }}px;padding:{{ section.settings.mobile_padding_y }}px 12px}
    .featured-pro-{{ section.id }} .featured-pro__header{display:block;margin-bottom:2rem}
    .featured-pro-{{ section.id }} .featured-pro__benefits{grid-template-columns:1fr;margin:-.5rem 0 1.5rem}
    .featured-pro-{{ section.id }} .featured-pro__benefit{padding:.85rem 1rem}
    .featured-pro-{{ section.id }} .featured-pro__benefit+.featured-pro__benefit{border-top:1px solid {{ section.settings.card_border }};border-left:0}
    .featured-pro-{{ section.id }} .featured-pro__benefit-icon{flex-basis:38px;width:38px;height:38px}
    .featured-pro-{{ section.id }} .featured-pro__view-all{display:inline-block;margin-top:1rem}
    .featured-pro-{{ section.id }} .featured-pro__grid{grid-template-columns:repeat({{ section.settings.columns_mobile }},minmax(0,1fr))}
    .featured-pro-{{ section.id }} .product-pro{padding:{% if section.settings.columns_mobile == '2' %}8px{% else %}12px{% endif %};border-radius:{% if section.settings.columns_mobile == '2' %}14px{% else %}var(--card-radius){% endif %}}
    .featured-pro-{{ section.id }} .product-pro__content{padding:1rem .2rem .1rem}
    .featured-pro-{{ section.id }} .product-pro__title{font-size:{% if section.settings.columns_mobile == '2' %}.78rem{% else %}.9rem{% endif %}}
    .featured-pro-{{ section.id }} .product-pro__price-current{font-size:{% if section.settings.columns_mobile == '2' %}1rem{% else %}1.2rem{% endif %}}
    .featured-pro-{{ section.id }} .product-pro__rating,.featured-pro-{{ section.id }} .product-pro__vendor{display:{% if section.settings.compact_mobile %}none{% else %}flex{% endif %}}
    .featured-pro-{{ section.id }} .product-pro__actions{grid-template-columns:1fr}
    .featured-pro-{{ section.id }} .product-pro__view{display:none}
    .featured-pro-{{ section.id }} .product-pro__button{min-height:42px;padding:.6rem;font-size:.64rem}
    .featured-pro-{{ section.id }} .product-pro__wishlist{width:36px;height:36px;top:8px;right:8px}
    .featured-pro-{{ section.id }} .product-pro__badges{top:8px;left:8px}
    .featured-pro-{{ section.id }} .product-pro__discount{display:none}
    .featured-pro-{{ section.id }} .product-spotlight{grid-template-columns:1fr;height:auto;margin:1rem 0;border-radius:18px}
    .featured-pro-{{ section.id }} .product-spotlight--reverse .product-spotlight__media{order:0}
    .featured-pro-{{ section.id }} .product-spotlight__media{min-height:220px}
    .featured-pro-{{ section.id }} .product-spotlight__media::after,.featured-pro-{{ section.id }} .product-spotlight--reverse .product-spotlight__media::after{background:linear-gradient(180deg,transparent 50%,var(--spotlight-bg))}
    .featured-pro-{{ section.id }} .product-spotlight__content{padding:1.6rem 1.25rem 2rem}
    .featured-pro-{{ section.id }} .product-spotlight__title{font-size:1.75rem}
  }
  @media(prefers-reduced-motion:reduce){.featured-pro-{{ section.id }} *{transition:none!important}.featured-pro-{{ section.id }} .product-pro:hover{transform:none}}
{% endstyle %}

<section class="featured-pro-{{ section.id }}">
  <div class="featured-pro__inner">
    {% assign selected_collection = collections[section.settings.collection] %}
    <header class="featured-pro__header" data-reveal>
      <div class="featured-pro__heading-wrap">
        {% if section.settings.eyebrow != blank %}<p class="featured-pro__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 class="featured-pro__title">{{ section.settings.title | escape }}</h2>
        {% if section.settings.subtitle != blank %}<div class="featured-pro__subtitle">{{ section.settings.subtitle }}</div>{% endif %}
        {% if section.settings.show_product_count and selected_collection != blank %}
          <div class="featured-pro__meta"><span class="featured-pro__meta-dot"></span>{{ selected_collection.products_count }} produtos selecionados para você</div>
        {% endif %}
      </div>
      {% if section.settings.show_view_all and selected_collection != blank %}
        <a class="featured-pro__view-all" href="{{ selected_collection.url }}">{{ section.settings.view_all_label | escape }} →</a>
      {% endif %}
    </header>

    {% if section.settings.show_benefits %}
      <div class="featured-pro__benefits" data-reveal>
        <div class="featured-pro__benefit">
          <span class="featured-pro__benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h11v11H3zM14 9h4l3 3v5h-7z"/><circle cx="7" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></svg></span>
          <div><strong>{{ section.settings.benefit_1_title | escape }}</strong><span>{{ section.settings.benefit_1_text | escape }}</span></div>
        </div>
        <div class="featured-pro__benefit">
          <span class="featured-pro__benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l8 4v5c0 5-3.4 8-8 9-4.6-1-8-4-8-9V7z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg></span>
          <div><strong>{{ section.settings.benefit_2_title | escape }}</strong><span>{{ section.settings.benefit_2_text | escape }}</span></div>
        </div>
        <div class="featured-pro__benefit">
          <span class="featured-pro__benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 10h16v10H4zM7 10V7a5 5 0 0 1 10 0v3"/><path d="M12 14v3"/></svg></span>
          <div><strong>{{ section.settings.benefit_3_title | escape }}</strong><span>{{ section.settings.benefit_3_text | escape }}</span></div>
        </div>
      </div>
    {% endif %}

    <div class="featured-pro__grid">
      {% if selected_collection != blank and selected_collection.products_count > 0 %}
        {% for product in selected_collection.products limit: section.settings.limit %}
          {% assign selected_variant = product.selected_or_first_available_variant %}
          {% assign discount = 0 %}
          {% if product.compare_at_price > product.price %}
            {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
          {% endif %}
          <article class="product-pro" data-reveal style="--reveal-delay:{{ forloop.index0 | modulo: section.settings.columns_desktop | times: 65 }}ms">
            <a class="product-pro__media" href="{{ product.url }}">
              {% if product.featured_image != blank %}
                <img class="product-pro__image product-pro__image--primary" src="{{ product.featured_image | image_url: width: 720 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" loading="lazy">
                {% if section.settings.show_secondary_image and product.images.size > 1 %}
                  {% assign secondary_image = product.images[1] %}
                  <img class="product-pro__image product-pro__image--secondary" src="{{ secondary_image | image_url: width: 720 }}" alt="{{ secondary_image.alt | default: product.title | escape }}" width="{{ secondary_image.width }}" height="{{ secondary_image.height }}" loading="lazy">
                {% endif %}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
              <span class="product-pro__badges">
                {% if section.settings.show_badge and discount > 0 %}<span class="product-pro__badge">{{ section.settings.badge_text }}</span><span class="product-pro__badge product-pro__discount">-{{ discount }}%</span>{% endif %}
                {% unless product.available %}<span class="product-pro__badge">Esgotado</span>{% endunless %}
              </span>
            </a>

            {% if section.settings.show_wishlist %}
              <span class="product-pro__wishlist">{% render 'wishlist-button', product: product %}</span>
            {% endif %}

            <div class="product-pro__content">
              {% if section.settings.show_vendor and product.vendor != blank %}<p class="product-pro__vendor">{{ product.vendor | escape }}</p>{% endif %}
              <a href="{{ product.url }}"><h3 class="product-pro__title">{{ product.title | escape }}</h3></a>
              {% assign card_rating = product.metafields.reviews.rating.value %}
              {% assign card_rating_count = product.metafields.reviews.rating_count.value %}
              {% if section.settings.show_rating and card_rating != blank %}<div class="product-pro__rating" aria-label="Avaliação real do produto">★★★★★ <span>{{ card_rating.rating | round: 1 }}{% if card_rating_count != blank %} ({{ card_rating_count }}){% endif %}</span></div>{% endif %}
              <div class="product-pro__price">
                <span class="product-pro__price-current">{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}<span class="product-pro__price-old">{{ product.compare_at_price | money }}</span>{% endif %}
              </div>
              {% if section.settings.show_pix_text %}<p class="product-pro__pix">{{ section.settings.pix_text }}</p>{% endif %}
              <div class="product-pro__actions">
                <button class="product-pro__button" type="button" data-quick-add data-variant-id="{{ selected_variant.id }}" {% unless selected_variant.available %}disabled{% endunless %}>
                  <span data-button-label>{% if selected_variant.available %}{{ section.settings.button_label }}{% else %}Esgotado{% endif %}</span>
                </button>
                <a class="product-pro__view" href="{{ product.url }}" aria-label="Ver {{ product.title | escape }}">↗</a>
              </div>
            </div>
          </article>
          {% assign current_product_position = forloop.index %}
          {% for block in section.blocks %}
            {% assign spotlight_position = block.settings.after_rows | times: section.settings.columns_desktop %}
            {% if current_product_position == spotlight_position %}
              {% assign spotlight_product = block.settings.product %}
              {% if spotlight_product != blank %}
                <article
                  class="product-spotlight{% if block.settings.image_side == 'right' %} product-spotlight--reverse{% endif %}"
                  style="--spotlight-bg:{{ block.settings.background }};--spotlight-text:{{ block.settings.text_color }};--spotlight-accent:{{ block.settings.accent_color }};--spotlight-fit:{{ block.settings.image_fit | default: 'contain' }};--spotlight-position:{{ block.settings.image_position | default: 'center' }}"
                  data-spotlight-reveal
                  {{ block.shopify_attributes }}
                >
                  <a class="product-spotlight__media" href="{{ spotlight_product.url }}">
                    {% if block.settings.custom_image != blank %}
                      {{ block.settings.custom_image | image_url: width: 1200 | image_tag: class: 'product-spotlight__image', loading: 'lazy', widths: '480, 720, 960, 1200' }}
                    {% elsif spotlight_product.featured_image != blank %}
                      {{ spotlight_product.featured_image | image_url: width: 1200 | image_tag: class: 'product-spotlight__image', loading: 'lazy', widths: '480, 720, 960, 1200' }}
                    {% endif %}
                  </a>
                  <div class="product-spotlight__content">
                    {% if block.settings.eyebrow != blank %}<p class="product-spotlight__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
                    <h3 class="product-spotlight__title">{{ block.settings.title | default: spotlight_product.title | escape }}</h3>
                    {% if block.settings.text != blank %}<div class="product-spotlight__text">{{ block.settings.text }}</div>{% endif %}
                    <div class="product-spotlight__price">
                      <strong>{{ spotlight_product.price | money }}</strong>
                      {% if spotlight_product.compare_at_price > spotlight_product.price %}<s>{{ spotlight_product.compare_at_price | money }}</s>{% endif %}
                    </div>
                    <a class="product-spotlight__button" href="{{ spotlight_product.url }}">{{ block.settings.button_label | escape }} <span>→</span></a>
                  </div>
                </article>
              {% endif %}
            {% endif %}
          {% endfor %}
        {% endfor %}
      {% else %}
        {% comment %}
          Keep the onboarding preview concise. Once a real collection is selected,
          the merchant-controlled product limit above remains fully respected.
        {% endcomment %}
        {% for i in (1..8) %}
          {% assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1 %}
          <article class="product-pro" data-reveal>
            <div class="product-pro__media">{{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="product-pro__content"><p class="product-pro__vendor">Sua marca</p><h3 class="product-pro__title">Produto de demonstração {{ i }}</h3><div class="product-pro__price"><span class="product-pro__price-current">R$ 149,90</span><span class="product-pro__price-old">R$ 249,90</span></div><p class="product-pro__pix">{{ section.settings.pix_text }}</p></div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
    {% if section.settings.show_footer_cta and selected_collection != blank %}
      <div class="featured-pro__footer" data-reveal>
        <a class="featured-pro__footer-link" href="{{ selected_collection.url }}">{{ section.settings.footer_cta_label | escape }} <span>→</span></a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Vitrine premium",
  "settings": [
    { "type": "header", "content": "Cabeçalho" },
    { "type": "text", "id": "eyebrow", "label": "Chamada", "default": "Escolhas que surpreendem" },
