    { "type": "text", "id": "benefit_1_text", "label": "Benefício 1 — descrição", "default": "Entrega rastreada do início ao fim" },
    { "type": "text", "id": "benefit_2_title", "label": "Benefício 2 — título", "default": "Compra protegida" },
