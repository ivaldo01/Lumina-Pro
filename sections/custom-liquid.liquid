{% style %}
  .custom-liquid-{{ section.id }}{padding:{{ section.settings.padding_top }}px clamp(1rem,3vw,2.5rem) {{ section.settings.padding_bottom }}px;background:{{ section.settings.background }};color:{{ section.settings.text_color }}}
  .custom-liquid-{{ section.id }} .custom-liquid__inner{width:min(100%,{{ section.settings.max_width }}px);margin:auto}
{% endstyle %}

<section class="custom-liquid-{{ section.id }}">
  <div class="custom-liquid__inner">
    {{ section.settings.custom_liquid }}
  </div>
</section>

{% schema %}
{
  "name": "Liquid personalizado",
  "settings": [
    { "type": "liquid", "id": "custom_liquid", "label": "Código Liquid", "info": "Use para conteúdo personalizado ou pontos de integração de aplicativos." },
    { "type": "range", "id": "max_width", "min": 800, "max": 1800, "step": 100, "unit": "px", "label": "Largura máxima", "default": 1400 },
    { "type": "color", "id": "background", "label": "Cor de fundo", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Cor do texto", "default": "#111827" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 10, "unit": "px", "label": "Espaçamento superior", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 10, "unit": "px", "label": "Espaçamento inferior", "default": 40 }
  ],
  "presets": [{ "name": "Liquid personalizado", "category": "Conteúdo" }]
}
{% endschema %}
