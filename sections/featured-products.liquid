        { "type": "select", "id": "image_fit", "label": "Enquadramento da imagem", "options": [{ "value": "contain", "label": "Mostrar produto inteiro" }, { "value": "cover", "label": "Preencher o espaço" }], "default": "contain" },
        { "type": "select", "id": "image_position", "label": "Posição da imagem", "options": [{ "value": "center", "label": "Centro" }, { "value": "center top", "label": "Topo" }, { "value": "center bottom", "label": "Base" }], "default": "center" },
        { "type": "select", "id": "image_side", "label": "Lado da imagem", "options": [{ "value": "left", "label": "Esquerda" }, { "value": "right", "label": "Direita" }], "default": "left" },
        { "type": "text", "id": "eyebrow", "label": "Chamada", "default": "Destaque especial" },
        { "type": "text", "id": "title", "label": "Título personalizado" },
        { "type": "richtext", "id": "text", "label": "Descrição", "default": "<p>Um produto escolhido para surpreender, com qualidade e condições especiais.</p>" },
        { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "Conhecer produto" },
