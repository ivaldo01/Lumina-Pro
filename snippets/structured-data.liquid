{% comment %}
  Structured Data (JSON-LD) for SEO
{% endcomment %}

{% if template contains 'product' %}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

{% elsif template contains 'collection' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "CollectionPage",
    "name": {{ collection.title | json }},
    "description": {{ collection.description | strip_html | json }},
    "url": {{ shop.url | append: collection.url | json }},
    "hasPart": [
      {% for product in collection.products limit: 10 %}
        {
          "@type": "Product",
          "name": {{ product.title | json }},
          "url": {{ shop.url | append: product.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
  </script>

{% elsif template == 'index' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": "{{ shop.url }}/search?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>

{% elsif template contains 'article' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "BlogPosting",
    "headline": {{ article.title | json }},
    "image": {{ article.image | image_url: width: 1600 | json }},
    "author": {
      "@type": "Person",
      "name": {{ article.author | json }}
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "logo": {{ settings.logo | image_url: width: 1200 | json }}
    },
    "datePublished": "{{ article.published_at | date: '%Y-%m-%d' }}",
    "dateModified": "{{ article.updated_at | date: '%Y-%m-%d' }}"
  }
  </script>

{% elsif template == 'cart' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "ItemList",
    "itemListElement": [
      {% for item in cart.items %}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "url": {{ shop.url | append: item.url | json }},
          "name": {{ item.product.title | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
  </script>
{% endif %}
